# ================================================================
# CodeAware 环境变量
# ================================================================
# 本地开发：复制为 .env 即可（docker-compose 映射端口与默认值一致）
# 生产部署：修改 LLM_API_KEY，建议改 PG_PASSWORD（需同步 docker-compose.yml）
# ================================================================

# Application
APP_NAME=codeaware

# 认证（团队化升级阶段 A：JWT access token，实验室内部使用）
# ⚠️ 生产部署必须替换为随机字符串（openssl rand -hex 32）
JWT_SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# LLM (DeepSeek, OpenAI 兼容 API)
# 生产环境必须替换为真实 key（真实 key 放在 .env，不入库）
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Ollama (本地 embedding, bge-m3 1024 维, Docker 组件)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# PostgreSQL 16 + pgvector (docker-compose 映射)
# ⚠️ 生产部署建议修改 PG_PASSWORD，并在 docker-compose.yml 同步更新
PG_HOST=localhost
PG_PORT=5433
PG_USER=aicenter
PG_PASSWORD=aicenter123
PG_DB=ai_center_py

# Redis 7 (docker-compose 映射)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Short-term memory / incremental summary
MEM_WINDOW_SIZE=20
MEM_SUMMARY_THRESHOLD=10
MEM_SUMMARY_INTERVAL=5
MEM_SUMMARY_BATCH_SIZE=20
MEM_SUMMARY_MAX_CHARS=12000

# Knowledge multipart upload (5 MiB raw / 200k parsed characters)
KNOWLEDGE_UPLOAD_MAX_BYTES=5242880
KNOWLEDGE_PARSED_MAX_CHARS=200000

# AIReadMe local snapshot (fail-closed by default).
# Enable only after setting absolute server-side roots as a JSON array.
AI_README_SNAPSHOT_ENABLED=false
LOCAL_PROJECT_ROOTS=[]
AI_README_SNAPSHOT_MAX_FILES=200
AI_README_SNAPSHOT_MAX_FILE_BYTES=262144
AI_README_SNAPSHOT_MAX_TOTAL_BYTES=2097152
AI_README_SNAPSHOT_MAX_PROMPT_CHARS=60000
AI_README_SNAPSHOT_TIMEOUT_SECONDS=5

# RAG 词法召回后端: bm25（生产推荐，ParadeDB pg_search）或 pg_trgm（回退）
# 本地开发如果没装 ParadeDB docker 镜像，用 pg_trgm
RAG_LEXICAL_BACKEND=bm25

# RAG 运行时（LangGraph 检索增强, ADR-0015）: graph=智能路由+自我纠错 / service=原路径
RAG_RUNTIME=graph

# Chat 模式（ADR-0016）: rag=确定性 RAG 状态机（默认） / agent=ReAct 工具循环
CHAT_MODE=rag

# Reranker（检索后语义精排, ONNX Runtime）: True=开启 / False=回退纯 RRF
RERANKER_ENABLED=True
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_TOP_N=20

# LLMOps（ADR-0017）: 请求边界注入检测（fail-closed）/ trace 是否保留思考全文
GUARDRAILS_ENABLED=True
AGENT_TRACE_INCLUDE_REASONING=False

# Reflection（ADR-0018）: agent 生成后自评重生成（agent 模式默认开启，RAG 不受影响；False 为 kill-switch）
AGENT_REFLECTION_ENABLED=True
AGENT_MAX_REFLECTIONS=1

# Celery 任务队列（复用 Redis Broker）
# 默认从 REDIS_HOST:REDIS_PORT/REDIS_DB 拼接，无需单独配置
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Kafka 事件流
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_TOPIC_PREFIX=codeaware.
